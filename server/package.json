{
  "name": "server",
  "version": "1.0.0",
  "description": "DevTinder auth service",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev-load": "cmd /c \"set UV_THREADPOOL_SIZE=12 && tsx watch src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "tsx watch src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "npx dotenv-cli -e .env.local -- drizzle-kit studio",
    "db:seed": "tsx src/db/seeds/seed.ts",
    "db:seed:test": "npx dotenv-cli -e .env.test -- tsx src/db/seeds/seed.ts",
    "db:seed:load-test": "npx dotenv-cli -e .env.local -- tsx src/db/seeds/load-test/index.ts",
    "db:seed:load-test:users": "npx dotenv-cli -e .env.local -- tsx src/db/seeds/load-test/index.ts users",
    "db:seed:feed": "npx dotenv-cli -e .env.local -- tsx src/db/seeds/load-test/index.ts feed",
    "db:seed:actions": "npx dotenv-cli -e .env.local -- tsx src/db/seeds/load-test/index.ts actions",
    "db:cleanup:load-test": "npx dotenv-cli -e .env.local -- tsx src/db/seeds/load-test/cleanup.ts",
    "db:cleanup:sessions": "npx dotenv-cli -e .env.local -- tsx src/db/scripts/cleanup-test-sessions.ts",
    "typecheck": "tsc --noEmit",
    "test:k6:auth": "docker compose -f docker-compose.k6.yml run --rm k6 run /scripts/scenarios/auth.js",
    "test:k6:stress": "docker compose -f docker-compose.k6.yml run --rm k6 run /scripts/scenarios/auth-stress.js",
    "test:k6:smoke": "docker compose -f docker-compose.k6.yml run --rm k6 run /scripts/scenarios/smoke-test.js",
    "test:k6:feed": "docker compose -f docker-compose.k6.yml run --rm k6 run /scripts/scenarios/feed-load.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^8.0.2",
    "@bull-board/express": "^8.0.2",
    "@types/pg": "^8.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cookieparser": "^0.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "geoip-lite": "^2.0.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "nanoid": "^5.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "rate-limit-redis": "^5.0.0",
    "resend": "^6.16.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^26.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
