# Optional local overrides loaded after .env during development.
# Copy to .env.local and replace values for your local services.

# Use localhost when Postgres and Redis run outside Docker.
DATABASE_URL=postgresql://devtinder:replace-with-your-password@localhost:5432/devtinder
REDIS_URL=redis://:replace-with-your-password@localhost:6379

# Set true only when running the local load-test seeders.
ENABLE_LOAD_TEST=false
