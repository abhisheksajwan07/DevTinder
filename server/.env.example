# Copy this file to .env for the environment where the server runs.
# Never commit .env or place real secrets in this file.

# Application
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins. Nginx uses http://localhost; Vite uses :5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
LOG_LEVEL=info

# Backend connections. For Docker Compose, use the service names below.
POSTGRES_DB=devtinder
POSTGRES_USER=devtinder
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://devtinder:replace-with-a-long-random-password@postgres:5432/devtinder

REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379

# Authentication and cookies
SALT_ROUNDS=12
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
CSRF_TOKEN_SECRET=replace-with-at-least-32-random-characters
# In a Compose-loaded .env, escape bcrypt dollar signs as $$.
# The container receives the normal $2b$... value.
DUMMY_HASH=$$2b$$12$$replace-with-a-valid-bcrypt-hash
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/oauth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_REDIRECT_URI=http://localhost:3000/v1/oauth/github/callback
GITHUB_CONNECT_REDIRECT_URI=http://localhost:3000/v1/oauth/github/connect/callback
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-64-character-hex-key-32-bytes

# Embeddings
VOYAGE_API_KEY=replace-me

# Keep this false or unset outside controlled load tests.
ENABLE_LOAD_TEST=false
